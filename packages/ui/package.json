{
  "name": "@dawnsight/ui",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "imports": {
    "#components/*": "./src/*.tsx",
    "#lib/*": "./src/*.ts",
    "#hooks/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./button": {
      "types": "./src/button.tsx",
      "default": "./src/button.tsx"
    },
    "./badge": {
      "types": "./src/badge.tsx",
      "default": "./src/badge.tsx"
    },
    "./checkbox": {
      "types": "./src/checkbox.tsx",
      "default": "./src/checkbox.tsx"
    },
    "./alert": {
      "types": "./src/alert.tsx",
      "default": "./src/alert.tsx"
    },
    "./collapsible": {
      "types": "./src/collapsible.tsx",
      "default": "./src/collapsible.tsx"
    },
    "./field": {
      "types": "./src/field.tsx",
      "default": "./src/field.tsx"
    },
    "./combobox": {
      "types": "./src/combobox.tsx",
      "default": "./src/combobox.tsx"
    },
    "./input": {
      "types": "./src/input.tsx",
      "default": "./src/input.tsx"
    },
    "./label": {
      "types": "./src/label.tsx",
      "default": "./src/label.tsx"
    },
    "./native-select": {
      "types": "./src/native-select.tsx",
      "default": "./src/native-select.tsx"
    },
    "./progress": {
      "types": "./src/progress.tsx",
      "default": "./src/progress.tsx"
    },
    "./slider": {
      "types": "./src/slider.tsx",
      "default": "./src/slider.tsx"
    },
    "./separator": {
      "types": "./src/separator.tsx",
      "default": "./src/separator.tsx"
    },
    "./tooltip": {
      "types": "./src/tooltip.tsx",
      "default": "./src/tooltip.tsx"
    },
    "./alert-dialog": {
      "types": "./src/alert-dialog.tsx",
      "default": "./src/alert-dialog.tsx"
    },
    "./dropdown-menu": {
      "types": "./src/dropdown-menu.tsx",
      "default": "./src/dropdown-menu.tsx"
    },
    "./scroll-area": {
      "types": "./src/scroll-area.tsx",
      "default": "./src/scroll-area.tsx"
    },
    "./switch": {
      "types": "./src/switch.tsx",
      "default": "./src/switch.tsx"
    },
    "./textarea": {
      "types": "./src/textarea.tsx",
      "default": "./src/textarea.tsx"
    },
    "./community-ai/tool-chip": {
      "types": "./src/community-ai/tool-chip.tsx",
      "default": "./src/community-ai/tool-chip.tsx"
    },
    "./community-ai/task-row": {
      "types": "./src/community-ai/task-row.tsx",
      "default": "./src/community-ai/task-row.tsx"
    },
    "./community-ai/approval-card": {
      "types": "./src/community-ai/approval-card.tsx",
      "default": "./src/community-ai/approval-card.tsx"
    },
    "./community-ai/context-card": {
      "types": "./src/community-ai/context-card.tsx",
      "default": "./src/community-ai/context-card.tsx"
    },
    "./community-ai/loading-state": {
      "types": "./src/community-ai/loading-state.tsx",
      "default": "./src/community-ai/loading-state.tsx"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "vitest": "^3.2.7"
  }
}
