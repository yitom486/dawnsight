{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dawnsight",
  "version": "0.4.3",
  "identifier": "com.dawnsight.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Dawnsight",
        "width": 960,
        "height": 640,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/yitom486/dawnsight/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ1RjFCNjUxQUE4MkM1RkQKUldUOXhZS3FVYmJ4MVNHN2R2b2hOd0dKUkREcW9ZR1pYT0NNdEkrelFFQmNTVXJmNFBPMExaaUYK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "bin/acp-engine"
    ],
    "resources": {
      "native/mpv/runtime/": "mpv/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
